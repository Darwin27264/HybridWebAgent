{
  "name": "ofln-scout",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/launch.mjs",
    "start:daemon": "node scripts/launch.mjs --daemon-only",
    "start:ui": "node scripts/launch.mjs --ui-only",
    "daemon": "pnpm --filter @ofln-scout/daemon start",
    "daemon:dev": "pnpm --filter @ofln-scout/daemon dev",
    "ui": "pnpm --filter @ofln-scout/desktop-ui dev",
    "ui:build": "pnpm --filter @ofln-scout/desktop-ui build",
    "prewarm": "node scripts/prewarm-laya.mjs",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r tsc --noEmit",
    "test:smoke": "pnpm --filter @ofln-scout/daemon test:smoke",
    "test": "pnpm -r test && pnpm test:e2e",
    "test:e2e": "tsx tests/e2e/runner.ts"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "onnxruntime-node",
      "esbuild"
    ]
  }
}
